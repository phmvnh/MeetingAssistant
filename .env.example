# Gemini Live transcription and Gemini structured meeting summarization
# Create an API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_SUMMARY_MODEL=gemini-3.5-flash
TRANSCRIPTION_LANGUAGES=vi,en
TRANSCRIPTION_PROMPT=Cuộc họp công việc bằng tiếng Việt, có thể xen thuật ngữ tiếng Anh.

# Google authentication (OAuth is recommended for personal Google accounts):
# - oauth: the user chooses a Google account in the browser. Docs, the automatic
#   Sheet and the primary Calendar belong to that account.
# - service_account: only for resources explicitly shared with the service account.
GOOGLE_AUTH_MODE=oauth
GOOGLE_SERVICE_ACCOUNT_PATH=credentials.json
GOOGLE_OAUTH_CREDENTIALS_PATH=oauth_credentials.json
GOOGLE_TOKEN_PATH=.google-oauth-token.json

# Google Sheets index. Leave SPREADSHEET_ID empty in OAuth mode to let the app
# find or create a dedicated spreadsheet in the signed-in account.
SPREADSHEET_ID=
GOOGLE_SPREADSHEET_TITLE=Meeting Log
SHEET_NAME=meeting_assistant

# OAuth always uses the signed-in account's primary Calendar. In service-account
# mode, replace this with the full ID of a Calendar shared with client_email.
CALENDAR_ID=primary
CALENDAR_TIME_ZONE=Asia/Ho_Chi_Minh

# Google Docs
GOOGLE_DOCS_ENABLED=true
# Optional for OAuth. Required for service-account Docs and must be a Shared Drive folder.
GOOGLE_DRIVE_FOLDER_ID=

# Always save a recoverable local Markdown/JSON copy.
# Leave empty to use Documents/Meeting Assistant.
LOCAL_DOCS_DIR=
